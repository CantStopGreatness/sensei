<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aryanthakur.sensei-lichess-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.config/lichess-bot/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart whenever it exits (crash, lost network), at most once a minute. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/lichess-bot/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/lichess-bot/bot.log</string>
</dict>
</plist>
